{
  "common": {
    "name": "homeradar",
    "version": "0.2.3",
    "title": "HomeRadar",
    "titleLang": {
      "en": "HomeRadar",
      "de": "HomeRadar"
    },
    "desc": {
      "en": "Presence detection for people and places with optional travel times",
      "de": "Anwesenheitserkennung für Personen und Orte mit optionalen Reisezeiten"
    },
    "authors": [
      "HomeRadar contributors"
    ],
    "author": "HomeRadar contributors",
    "license": "MIT",
    "platform": "Javascript/Node.js",
    "mode": "daemon",
    "enabled": true,
    "messagebox": true,
    "adminUI": {
      "config": "json"
    },
    "type": "geoposition",
    "connectionType": "local",
    "dataSource": "push",
    "compact": true,
    "dependencies": [
      {
        "js-controller": ">=6.0.11"
      }
    ],
    "globalDependencies": [
      {
        "admin": ">=7.0.23"
      }
    ],
    "keywords": [
      "location",
      "presence",
      "geofence",
      "travel time"
    ],
    "readme": "README.md",
    "icon": "homeradar.png",
    "extIcon": "https://raw.githubusercontent.com/BeSiRe1/ioBroker.homeradar/main/admin/homeradar.png",
    "news": {
      "NEXT": {
        "en": "Calculate only home routes, organize current-location coordinates and map links in separate channels, add per-person address refresh distances, and track API requests with a 30-day history and nearby-address filtering.",
        "de": "Nur Heimrouten berechnen, Koordinaten und Kartenlinks in eigene Ordner einsortieren, Adressabstände je Person einstellen und API-Aufrufe mit 30-Tage-Verlauf sowie Filter für nahe Adresstreffer ergänzen."
      }
    }
  },
  "encryptedNative": [
    "geoapifyApiKey"
  ],
  "protectedNative": [
    "geoapifyApiKey"
  ],
  "objects": [],
  "instanceObjects": [
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "name": "Verbindung aktiv",
        "type": "boolean",
        "role": "indicator.connected",
        "read": true,
        "write": false
      },
      "native": {}
    }
  ],
  "native": {
    "useGeoapifyRoutingFallback": false,
    "useGeoapifyAddressLookup": false,
    "peopleTab": {
      "people": []
    },
    "placesTab": {
      "places": []
    },
    "routingTab": {
      "routingEnabled": true,
      "routingUrl": "https://router.project-osrm.org",
      "useGeoapifyRoutingFallback": false,
      "useGeoapifyAddressLookup": false,
      "geoapifyApiKey": ""
    }
  }
}
