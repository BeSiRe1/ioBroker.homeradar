{
  "common": {
    "name": "homeradar",
    "version": "0.1.0",
    "title": "HomeRadar",
    "titleLang": {
      "en": "HomeRadar",
      "de": "HomeRadar"
    },
    "desc": {
      "en": "Presence detection for people and places with optional travel times",
      "de": "Anwesenheitserkennung für Personen und Orte mit optionalen Reisezeiten"
    },
    "authors": [
      "HomeRadar contributors"
    ],
    "author": "HomeRadar contributors",
    "license": "MIT",
    "platform": "Javascript/Node.js",
    "mode": "daemon",
    "enabled": true,
    "messagebox": true,
    "adminUI": {
      "config": "json"
    },
    "type": "geoposition",
    "connectionType": "local",
    "dataSource": "push",
    "compact": true,
    "dependencies": [
      {
        "js-controller": ">=6.0.11"
      }
    ],
    "globalDependencies": [
      {
        "admin": ">=7.0.23"
      }
    ],
    "keywords": [
      "location",
      "presence",
      "geofence",
      "travel time"
    ],
    "readme": "README.md",
    "icon": "homeradar.png",
    "news": {
      "NEXT": {
        "en": "Added OpenRouteService as an optional fallback when the OSRM routing service is unavailable.",
        "de": "OpenRouteService kann bei Ausfall des OSRM-Routingdienstes optional als Ausweichdienst verwendet werden."
      }
    }
  },
  "encryptedNative": [
    "openRouteServiceApiKey"
  ],
  "protectedNative": [
    "openRouteServiceApiKey"
  ],
  "objects": [],
  "instanceObjects": [
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "name": "Verbindung aktiv",
        "type": "boolean",
        "role": "indicator.connected",
        "read": true,
        "write": false
      },
      "native": {}
    }
  ],
  "native": {
    "people": [],
    "places": [],
    "routingEnabled": true,
    "routingUrl": "https://router.project-osrm.org",
    "useOpenRouteServiceFallback": false,
    "openRouteServiceApiKey": "",
    "updateIntervalMinutes": 5
  }
}
